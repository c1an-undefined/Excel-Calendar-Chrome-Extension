{
    "name": "Excel to Calendar",
    "description": "Take dates from an excel spreadsheet and add them to calendar",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": "excel-logo.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "xlsx.full.min.js"
            ],
            "matches": [
                "chrome-extension://*/*"
            ]
        }
    ]
}